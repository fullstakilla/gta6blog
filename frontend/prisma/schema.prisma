generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleTag {
  TRAILER
  LEAK
  MAP
  CHARACTER
  GAMEPLAY
  RUMOR
}

enum ArticleStatus {
  draft
  published
  archived
}

enum AuthorRole {
  author
  editor
  admin
}

enum CommentStatus {
  pending
  approved
  rejected
  spam
}

enum ReactionType {
  fire
  love
  laugh
  think
  hundred
}

model Author {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AuthorRole @default(author)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  articles     Article[]

  @@map("authors")
}

model Article {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?       @map("cover_image")
  category    ArticleTag
  tags        String[]      @default([])
  authorId    String?       @map("author_id") @db.Uuid
  author      Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status      ArticleStatus @default(draft)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  viewsCount  BigInt        @default(0) @map("views_count")
  metaTitle   String?       @map("meta_title")
  metaDesc    String?       @map("meta_desc")
  isFeatured  Boolean       @default(false) @map("is_featured")

  comments    Comment[]
  reactions   Reaction[]

  @@index([slug])
  @@index([publishedAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@map("articles")
}

model Comment {
  id          String        @id @default(uuid()) @db.Uuid
  articleId   String        @map("article_id") @db.Uuid
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parentId    String?       @map("parent_id") @db.Uuid
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  authorName  String        @map("author_name")
  authorEmail String?       @map("author_email")
  content     String
  status      CommentStatus @default(pending)
  ipHash      String?       @map("ip_hash")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([articleId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("comments")
}

model Reaction {
  id           String       @id @default(uuid()) @db.Uuid
  articleId    String       @map("article_id") @db.Uuid
  article      Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reactionType ReactionType @map("reaction_type")
  fingerprint  String
  ipHash       String       @map("ip_hash")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([articleId, reactionType, fingerprint])
  @@index([articleId])
  @@map("reactions")
}

model Subscriber {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  confirmed     Boolean  @default(true)
  confirmToken  String?  @map("confirm_token")
  subscribedAt  DateTime @default(now()) @map("subscribed_at") @db.Timestamptz
  ipHash        String?  @map("ip_hash")

  @@map("subscribers")
}
