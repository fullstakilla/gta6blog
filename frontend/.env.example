# ─── Database ─────────────────────────────────────────────────────────────
# Postgres connection string. В dev — локальный: postgres://<user>@localhost:5432/gta6_blog
# В проде — от твоего хостинга.
DATABASE_URL="postgresql://user@localhost:5432/gta6_blog?schema=public"

# ─── Session (iron-session encrypted cookie) ──────────────────────────────
# Минимум 32 символа. Сгенерировать: openssl rand -base64 32
# Смена секрета инвалидирует ВСЕ активные сессии админов.
IRON_SESSION_SECRET="change-me-min-32-chars-openssl-rand-base64-32"

# ─── IP hashing salt ──────────────────────────────────────────────────────
# Используется для sha256(ip + salt) в комментах/реакциях/подписке.
# Обязателен — без него код бросает исключение (152-ФЗ, GDPR).
# Сгенерировать: openssl rand -hex 16
IP_HASH_SALT="change-me-random-string"

# ─── Site URL (canonical, OG, sitemap) ────────────────────────────────────
# В dev можно не задавать (fallback https://gta6blog.ru), в проде — обязательно.
NEXT_PUBLIC_SITE_URL="https://gta6blog.ru"

# ─── S3-совместимое хранилище (MinIO на VPS в проде) ──────────────────────
# Загружаемые обложки статей и картинки галереи. В dev без S3 не работает
# upload из админки — можно поднять локальный MinIO или писать в прод-бакет.
S3_ENDPOINT="https://gta6media.duckdns.org"
S3_REGION="us-east-1"
S3_BUCKET="gta6-uploads"
S3_ACCESS_KEY="get-from-vps-admin"
S3_SECRET_KEY="get-from-vps-admin"
# Опционально: другой публичный базовый URL (для CDN). Fallback — S3_ENDPOINT/S3_BUCKET.
# S3_PUBLIC_BASE="https://cdn.example.com/gta6-uploads"
